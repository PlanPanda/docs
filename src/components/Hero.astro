---
import { Image } from 'astro:assets';
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';
import { LinkButton } from '@astrojs/starlight/components';

const PAGE_TITLE_ID = '_top';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const lightImage = image && 'light' in image ? image.light : undefined;
const darkImage = image && 'dark' in image ? image.dark : undefined;
---

<div class="sp-hero">
	<div class="sp-hero-copy">
		<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
		{data.draft && <DraftContentNotice />}
		{tagline && <div class="tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, link: href, text, variant }) => (
						<LinkButton {href} {variant} class:list={[className]} {...attrs}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
	{
		lightImage && (
			<Image
				src={lightImage}
				alt={image?.alt || ''}
				width={420}
				height={420}
				loading="eager"
				decoding="async"
				class="sp-hero-mascot sp-only-light"
			/>
		)
	}
	{
		darkImage && (
			<Image
				src={darkImage}
				alt=""
				width={420}
				height={420}
				loading="eager"
				decoding="async"
				class="sp-hero-mascot sp-only-dark"
			/>
		)
	}
</div>

<style>
	.sp-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.75rem;
		padding-block: clamp(3rem, calc(1rem + 8vmin), 6.5rem) 1.5rem;
	}

	.sp-hero-copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.sp-hero-copy > * {
		max-width: 46ch;
	}

	h1 {
		margin: 0;
		font-size: clamp(var(--sl-text-4xl), calc(0.5rem + 4.5vw), var(--sl-text-6xl));
		line-height: 1.25;
		font-weight: 700;
		color: var(--sl-color-white);
		text-wrap: balance;
	}

	.tagline {
		font-size: clamp(var(--sl-text-lg), calc(0.5rem + 1.25vw), var(--sl-text-2xl));
		line-height: 1.7;
		color: var(--sl-color-gray-3);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
		margin-top: 0.75rem;
	}

	.sp-hero-mascot {
		width: min(19rem, 62vw);
		height: auto;
	}

	.sp-only-dark {
		display: none;
	}

	:global(html[data-theme='dark']) .sp-only-light {
		display: none;
	}

	:global(html[data-theme='dark']) .sp-only-dark {
		display: block;
	}

	@media (prefers-reduced-motion: reduce) {
		.sp-hero {
			animation: none;
			transition: none;
		}
	}
</style>
