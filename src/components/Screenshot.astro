---
import { Image, type ImageMetadata } from 'astro:assets';

interface Props {
	/** ชื่อไฟล์ (ไม่ต้องมีนามสกุล) เช่น "customers/list-overview" — รูปจะถูกอ่านจาก src/assets/manual/<name>.png */
	name: string;
	/** ข้อความ alt + บอกด้วยว่าต้อง capture อะไรในกรอบ */
	alt: string;
	/** รายละเอียดเพิ่มเติมของภาพที่ต้องการ (สถานะหน้าจอ, ตำแหน่งที่ต้องชี้ ฯลฯ) */
	spec?: string;
}

const { name, alt, spec } = Astro.props;

// รูปคู่มือทั้งหมดอยู่ที่ src/assets/manual/<กลุ่ม>/<ชื่อ>.png — glob แบบ eager
// ให้ได้ ImageMetadata ต่อไฟล์ แล้วหาจากชื่อ; ไฟล์ที่ยังไม่มี = ไม่อยู่ใน map = เข้า placeholder
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/manual/**/*.png', {
	eager: true,
});
const src = Object.entries(images).find(([key]) => key.endsWith(`/${name}.png`))?.[1].default;
---

{
	src ? (
		<figure class="sp-screenshot">
			<Image
				src={src}
				alt={alt}
				widths={[640, 960, 1280]}
				sizes="(min-width: 50rem) 45rem, 100vw"
				format="webp"
				loading="lazy"
				decoding="async"
			/>
			{spec && <figcaption set:html={spec} />}
		</figure>
	) : (
		<div class="screenshot-placeholder">
			<div>
				<span class="screenshot-name">src/assets/manual/{name}.png</span>
			</div>
			<div>ต้องการรูป: {alt}</div>
			{spec && <div>{spec}</div>}
		</div>
	)
}

<style>
	.sp-screenshot {
		margin: 1.5rem 0;
	}

	.sp-screenshot img {
		width: 100%;
		height: auto;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 8px;
	}

	.sp-screenshot figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
